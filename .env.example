# Public application settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Admin authentication. Generate the password hash and session secret locally.
# ADMIN_PASSWORD_HASH must be a bcrypt hash (cost 12 or higher).
# ADMIN_SESSION_SECRET must be at least 32 random bytes, encoded as a string.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE=604800

# Optional end-to-end test credentials. Keep these local/CI-only.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
